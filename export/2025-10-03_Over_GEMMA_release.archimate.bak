    <folder name="Portfolio" id="id-38d4d7c601ac49b2822f729a01fde749">
      <element xsi:type="archimate:BusinessObject" name="Werken onder architectuur" id="4a89ce6b">
        <documentation>Handreiking voor gemeenten hoe zij met GEMMA kunnen werken onder architectuur
Dit zijn begeleidende documenten voor de verdere uitwerking van de GEMMA.</documentation>
        <property key="Object ID" value="1f161525-b2f6-4177-ba5c-35daaf27ad01"/>
        <property key="Algemene producten" value="ja"/>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Data" id="62f9f4e9">
        <documentation>Thema-architectuur die aspecten met betrekking tot data uitwerkt. &#xD;
Bijvoorbeeld: datamanagement en data-uitwisseling.</documentation>
        <property key="Object ID" value="41cd1254-cb22-4d0f-aa9a-0cec3fd48ae5"/>
        <property key="Thema-architecturen" value="ja"/>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Actoren en rollen" id="840376b1">
        <documentation>Het actoren en rollenmodel toont de (rechts)personen en organisatorische eenheden (actoren) en de verantwoordelijkheden (rollen)</documentation>
        <property key="Object ID" value="09eb7922-219a-4494-89b7-e662a41b8844"/>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Zaakgericht werken" id="cec10e70">
