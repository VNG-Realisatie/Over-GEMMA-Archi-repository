          <child xsi:type="archimate:Group" id="id-50cbfce7bb3e4f80854663f8a704b338" name="Groeperen" font="1|Segoe UI|10.8|1|WINDOWS|1|-18|0|0|0|700|0|0|0|0|3|2|1|34|Segoe UI" textAlignment="1" fillColor="#ffffff" borderType="1">
