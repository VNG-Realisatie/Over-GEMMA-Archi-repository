  <folder name="Motivation" id="461f1cab-9aac-4f87-9d9c-f93c4e15649b" type="motivation">
    <folder name="Kennismodel" id="id-be8385eb8c1a47a8947b61eb30f5dee6">
      <element xsi:type="archimate:Constraint" name="Standaard" id="id-81077">
        <documentation>Een document met erkende afspraken, specificaties of criteria over een product, een dienst of een methode.</documentation>
        <property key="Object ID" value="f144971a-c7cb-43b6-a461-56e4cdea56a0"/>
        <property key="Bron" value="Wikipedia"/>
      </element>
      <element xsi:type="archimate:Driver" name="Kernwaarde" id="id-7411097eb4224fb99e0989c5f72484e5">
        <documentation>Fundamentele overtuigingen, gebaseerd op maatschappelijke waarden, waar overheidsdienstverlening aan moet voldoen</documentation>
        <property key="Object ID" value="93b02ab6-137b-4bc3-9c0f-9ba812bca47e"/>
        <property key="Bron" value="NORA"/>
      </element>
      <element xsi:type="archimate:Driver" name="Beleidskader" id="id-906e3bfc38ef49ed86ea6cc9e8d7ba9f">
        <documentation>Beleidskader is gebaseerd op bestaand overheidsbeleid (Nationaal en Europees) en op de instrumenten die in het kader van dat beleid zijn ontwikkeld, zoals wetten, regelgeving, Kamerstukken en bestuursakkoorden</documentation>
        <property key="Bron" value="NORA"/>
        <property key="URL" value="https://www.noraonline.nl/wiki/Beleidskaders"/>
        <property key="Object ID" value="53a70ddc-35a1-439b-b012-28e72a82f59b"/>
      </element>
      <element xsi:type="archimate:Goal" name="Kwaliteitsdoel" id="id-e9423a50debe404f897ccd5edbdb89ae">
        <documentation>Gewenste kenmerken van overheidsdienstverlening vanuit het perspectief van de wensen van de samenleving, de burgers en bedrijven.</documentation>
        <property key="Object ID" value="f1c0fdc0-fe49-4c2a-a67a-aed652fbf0fb"/>
        <property key="Bron" value="NORA"/>
      </element>
      <element xsi:type="archimate:Principle" name="Architectuurprincipe" id="id-81079">
        <documentation>Een kwalitatieve intentieverklaring waaraan de architectuur moet voldoen.</documentation>
        <property key="Object ID" value="e757726b-bd6f-4db0-b557-6bcfe4e69e91"/>
        <property key="Bron" value="ArchiMate"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Requirement" id="id-1550bdff3a5a40c5a256e21ca75311f2">
        <documentation>Een eis die geldt voor een specifiek informatiesysteem of onderdeel daarvan binnen de architectuur.</documentation>
        <property key="Object ID" value="5c22cf25-6233-48c4-af19-a4ca71196b6a"/>
        <property key="Bron" value="GEMMA"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Implicatie" id="id-813c9f510dbf4d3180fec008afa51742">
        <documentation>De consequenties van een architectuurprincipe op jouw praktijk (eigen context, project, organisatie)</documentation>
        <property key="Object ID" value="21c9b5a9-6d9d-47c8-9400-93063429d86d"/>
        <property key="Bron" value="GEMMA"/>
      </element>
    </folder>
    <element xsi:type="archimate:Constraint" name="Standaard 2" id="id-80907">
      <property key="Object ID" value="cd6be2e7-2279-4c71-99c1-3968e297016b"/>
      <property key="Bron" value="GEMMA"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Standaard 3" id="id-80911">
      <property key="Object ID" value="dbe85762-0be2-49b9-ab46-b459b8d45c9c"/>
      <property key="Bron" value="GEMMA"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Standaard 1" id="id-80913">
      <property key="Object ID" value="7dd4c0bb-845b-4136-803b-a9a4312f9c7a"/>
      <property key="Bron" value="GEMMA"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Standaardversie" id="id-80986">
      <documentation>Een door de beheerder van de standaard uitgebrachte versie van de standaard</documentation>
      <property key="Object ID" value="7650b4e2-1f91-434e-a7cb-40286aceaa59"/>
      <property key="Bron" value="GEMMA"/>
    </element>
    <element xsi:type="archimate:Value" name="Waarde" id="id-81160">
      <documentation>Value represents the relative worth, utility, or importance of a core element or an outcome.</documentation>
      <property key="Object ID" value="e1af2067-5f27-4393-a110-b709a6c5baa7"/>
      <property key="Bron" value="ArchiMate"/>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="570c9421-e777-41aa-9838-3524e4ef6067" type="implementation_migration"/>
  <folder name="Other" id="a4cb7f7c-602a-4bee-bfd8-5c25cbdc3de0" type="other">
    <element xsi:type="archimate:Grouping" name="VNG standaarden repositories" id="id-0c8473a71da8436aa3418ddc06a4c026">
      <property key="Object ID" value="f97c43f1-b5f0-4d56-8ddd-6c72bda90d71"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Omgeving leverancier" id="id-2e629270d19e4a1fab00097e8863642f">
      <property key="Object ID" value="55f794a9-90b7-49ca-b32f-32a475da35d7"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Persona's leveranciers" id="id-44ebaccd819d4986b6b6ba1b81e67029">
      <property key="Object ID" value="12720b32-f369-4398-8389-cbfeb6b7528a"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Omgeving VNG" id="id-50eb5f82189046848c5f7c5d8b6071a1">
      <documentation>Toegankelijk voor VNG</documentation>
      <property key="Object ID" value="07113984-2155-4405-af70-f82cb115526c"/>
    </element>
    <element xsi:type="archimate:Grouping" name="VNG Archi-repositories" id="id-627f97ee9fe041c4abaf7b7cd4017b36">
      <documentation>Verzameling van door VNG beheerde ArchiMate repositories. De repository is de fysieke opslag van een architectuurmodel.  Opslag met behulp van git maakt versiebeheer en samenwerking in één model mogelijk.</documentation>
      <property key="Object ID" value="3a193b69-0fd7-46de-835a-b2b6dd6f3fb8"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Gradaties" id="id-81088">
      <documentation>Indeling van standaarden voor de (mate van) bouwbaarheid en testbaarheid. Standaarden kunnen als producten worden getypeerd in eindproducten, halffabrikaten, grondstoffen en gegevensstandaarden. Deze typering is een indicatie wat de benodigde inspanning is om de specificatie te completeren om tot een werkende koppeling te komen.</documentation>
      <property key="Object ID" value="bf7f99b1-fc8d-423d-a001-d3510924760d"/>
      <property key="Bron" value="GEMMA"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Domein" id="id-81091">
      <documentation>Een groep bedrijfsfuncties en -objecten die in de gemeentelijke praktijk vaak in samenhang worden ingericht en gebruikt</documentation>
      <property key="Object ID" value="3e35ecc6-2515-411f-92b8-adfaa8f2a2c3"/>
      <property key="Bron" value="GEMMA"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Persona's gemeenten (bron VNG onderzoek)" id="id-8575c200cf61486d8738ca09ac58a1f8">
      <property key="Object ID" value="ab6c2c69-0936-4cad-99ae-379247d8ab2b"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Gebruik van de GEMMA door VNG" id="id-bb307521300844a5a0bd6ef1b82cdb56">
      <documentation>Groep van producten van de VNG waarin één of meerdere GEMMA producten worden gebruikt</documentation>
      <property key="Object ID" value="5b886eae-265c-4773-bf62-7280f911cb39"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Groep" id="id-bd33c6c868514f7780d80f62179cb315">
      <documentation>The grouping element aggregates or composes concepts that belong together based on some common characteristic.</documentation>
      <property key="Object ID" value="25e9da3c-ac44-445b-b30a-478e5c0292b8"/>
      <property key="Bron" value="ArchiMate"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Beleidsdomein" id="id-cc834a475c2640e9b325c153e027c14b">
      <documentation>Een afgebakend gebied binnen gemeenten waarvoor specifieke beleidsmaatregelen, regels en verantwoordelijkheden gelden. De GEMMA en het Gemeentelijk GegevensModel gebruiken dezelfde, op IV3 gebaseerde, indeling.</documentation>
      <property key="URL" value="https://www.rijksoverheid.nl/onderwerpen/financien-gemeenten-en-provincies/uitwisseling-financiele-gegevens-met-sisa-en-iv3/informatie-voor-derden-iv3"/>
      <property key="Object ID" value="61cd4b5a-be2a-4fe8-bd50-f5f77e536921"/>
      <property key="Bron" value="GEMMA"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Domein en doelgroep" id="id-cd429ccfa12247a4830e8894e1a96bd1">
      <documentation>De groepering van applicatieservices voor een doelgroep binnen een domein</documentation>
      <property key="Object ID" value="79fbf08f-0c1f-490d-8476-b6af584e9537"/>
      <property key="Bron" value="GEMMA"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Buitengemeentelijk stelsel" id="id-dc831168417f4d2ebb95ff02cb30a5d1">
      <documentation>Groep van landelijke- of sectorale informatievoorzieningen</documentation>
      <property key="Object ID" value="51dc6b4a-4dfa-4f83-9eb2-fac315707f73"/>
      <property key="Bron" value="GEMMA"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Communicatiekanalen &amp; voorzieningen" id="id-e153a15c923b41348ca3ad8ac7b250a1">
      <documentation>Faciliteiten die bijdragen aan de verdere totstandkoming van de GEMMA</documentation>
      <property key="Object ID" value="850cc2ab-ed36-4ecb-bfb9-a30f2b850049"/>
    </element>
  </folder>
