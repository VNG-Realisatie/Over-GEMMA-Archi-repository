    <folder name="Kennismodel" id="id-3f58a63a44d24eb09c56effe2ddf011c">
      <element xsi:type="archimate:BusinessActor" name="Actor" id="id-81162">
        <documentation>Een organisatie, afdeling daarbinnen of persoon die activiteiten kan uitvoeren.</documentation>
        <property key="Object ID" value="6afd0bd7-eda8-4f99-b7ab-c3115f0c9e4a"/>
        <property key="Bron" value="GEMMA"/>
      </element>
      <element xsi:type="archimate:BusinessCollaboration" name="Bedrijfssamenwerking" id="id-81166">
        <documentation>Een bedrijfssamenwerking is een (tijdelijke) samenstelling van twee of meer bedrijfsrollen resulterend in een specifiek collectief gedrag in een bepaalde context.</documentation>
        <property key="Object ID" value="83a74e9c-1f59-4826-aa2a-415948d703d8"/>
        <property key="Bron" value="ArchiMate"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Gebeurtenis" id="id-81136">
        <documentation>Iets dat binnen of buiten een organisatie is gebeurd en binnen die organisatie of daarbuiten gevolgen heeft.</documentation>
        <property key="Object ID" value="a03cab2c-ca52-4d3f-8230-4b7c3fe592da"/>
        <property key="Bron" value="GEMMA"/>
      </element>
      <element xsi:type="archimate:BusinessFunction" name="Bedrijfsfunctie" id="id-44bbb0184dbb43adaca73495aaf7155f">
        <documentation>Activiteiten die zijn gegroepeerd omdat daarvoor vergelijkbare bedrijfsmiddelen, kennis of competenties nodig zijn.</documentation>
        <property key="Object ID" value="d6b1051e-b169-44ab-9f53-242b8cad0e35"/>
        <property key="Bron" value="GEMMA"/>
      </element>
      <element xsi:type="archimate:BusinessInterface" name="Kanaal" id="id-0a46b46d497d437e9865c794d3708152">
        <documentation>Communicatiekanaal dat bij de dienstverlening wordt gebruikt. Elk kanaal kent verschillende vormen waarin informatie kan worden gedeeld.</documentation>
        <property key="Object ID" value="b2ecce83-a72e-41c0-95b0-00733bde2114"/>
        <property key="Bron" value="NORA"/>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Bedrijfsobject" id="id-81158">
        <documentation>Een concept dat binnen een bepaald domein wordt gebruikt en betekenis heeft.</documentation>
        <property key="Object ID" value="31c9d5c8-bb3c-42b8-9c45-e356f7c5e6ff"/>
        <property key="Bron" value="GEMMA"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Bedrijfsproces" id="id-81137">
        <documentation>Reeks opeenvolgend uit te voeren activiteiten die bijdraagt aan een specifiek resultaat, zoals de levering van een product of Product of Dienst.</documentation>
        <property key="Object ID" value="ad7e9a1d-bd32-4cd5-a764-779324db7eaf"/>
        <property key="Bron" value="GEMMA"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Rol" id="id-81182">
        <documentation>Een bedrijfsrol is de verantwoordelijkheid voor specifiek gedrag waar een bedrijfsactor aan toegewezen kan worden.</documentation>
        <property key="Object ID" value="39fdcad2-9e8e-4664-a3d5-25187bc2d65a"/>
        <property key="Bron" value="ArchiMate"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Dienst" id="id-81155">
        <documentation>Een afgebakende prestatie van een persoon of organisatie (de dienstverlener), die voorziet in een behoefte van haar omgeving (de dienstafnemer(s)).</documentation>
        <property key="Object ID" value="2648fc2f-5f28-40a2-8c66-838d956be736"/>
        <property key="Bron" value="NORA"/>
      </element>
      <element xsi:type="archimate:Product" name="Product / voorziening" id="id-81174">
        <documentation>Een samenhangende set Diensten, Bedrijfsobjecten en/of Representaties die onder in een Overeenkomst beschreven voorwaarden kan worden afgenomen.</documentation>
        <property key="Object ID" value="7a6deb3a-ba40-4081-98d9-4befa1db1919"/>
        <property key="Bron" value="GEMMA"/>
      </element>
    </folder>
